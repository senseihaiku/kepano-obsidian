filters:
  and:
    - '!file.name.contains("Template")'
    - categories.contains(link("Fractal"))
properties:
  file.name:
    displayName: Entry
  note.created:
    displayName: Created
  status:
    displayName: Status
views:
  - type: table
    name: Inbox
    filters:
      and:
        - status.is("inbox")
    order:
      - file.name
      - created
      - status
  - type: table
    name: Processed
    filters:
      and:
        - status.is("processed")
    order:
      - file.name
      - created
      - status
  - type: table
    name: All
    order:
      - file.name
      - created
      - status
